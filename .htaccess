# ==========================================================
#  Geldi Geçti Hatıralar — IONOS (Apache) ayarları
# ==========================================================
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# Yazı tipi ve resim türleri
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType image/webp .webp

# HTTPS'e yönlendirme — SSL sertifikası etkinleştirildikten sonra
# aşağıdaki 3 satırın başındaki # işaretlerini kaldırın:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Araç ve belge dosyalarını ziyaretçilere kapat
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(araclar|\.git)(/.*)?$

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Önbellek: fotoğraf ve yazı tipleri uzun, içerik dosyaları kısa süre
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
